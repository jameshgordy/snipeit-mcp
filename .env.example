# Snipe-IT MCP Server Configuration
# Copy this file to .env and fill in your values

# ----- Required for both auth modes -----

# Your Snipe-IT instance URL (including https://)
SNIPEIT_URL=https://your-snipeit-instance.com


# ----- Mode A: static personal-access token (stdio or HTTP, single identity) -----

# Generate at: Snipe-IT user profile > Manage API Keys / Personal Access Tokens
SNIPEIT_TOKEN=your-api-token-here


# ----- Mode B: interactive OAuth (HTTP only, per-user identity) -----
# Uncomment and configure to enable OAuth mode. SNIPEIT_TOKEN is ignored when
# these are set.

# OAuth client created at https://your-snipeit-instance.com/admin/oauth
# Redirect URI on the OAuth client must be: <SNIPEIT_MCP_BASE_URL>/auth/callback
#SNIPEIT_OAUTH_CLIENT_ID=
#SNIPEIT_OAUTH_CLIENT_SECRET=

# Public URL where this MCP server is reachable (used to build the callback URL)
#SNIPEIT_MCP_BASE_URL=https://your-mcp-public-url

# OAuth mode requires HTTP transport
#MCP_TRANSPORT=http
#MCP_PORT=8000
#MCP_HOST=127.0.0.1   # use 0.0.0.0 only behind a reverse proxy

# Optional: comma-separated tool allowlist
#SNIPEIT_ALLOWED_TOOLS=manage_assets,system_info

# Optional: DEBUG / INFO / WARNING / ERROR / CRITICAL (default INFO)
#LOG_LEVEL=INFO


# ----- Optional: judgment backend for the data-quality tools -----
# find_duplicates / match_records are hidden from tools/list until one of these
# is set. Record names, model numbers, addresses and supplier/company contact
# details are sent to the backend — self-host if that is not acceptable.
#
# TypeSafe Jev (hosted; the typesafe-sdk variable names work as-is):
#TYPESAFE_API_KEY=
#TYPESAFE_DEFAULT_MODEL=jev-latest   # pin e.g. jev-1.13.0 once thresholds are tuned
#
# Self-hosted System One model (Laya, CLM, ...) serving POST /v1/systemone:
#JUDGMENT_BACKEND=systemone
#JUDGMENT_BASE_URL=http://laya:8080
#JUDGMENT_MODEL=laya
#
# Ollama or any OpenAI-compatible chat server with JSON-schema structured outputs:
#JUDGMENT_BACKEND=openai
#JUDGMENT_BASE_URL=http://localhost:11434/v1
#JUDGMENT_MODEL=qwen3:8b
#JUDGMENT_SAMPLES=1                  # >1 votes across samples instead of self-reported confidence
#JUDGMENT_API_KEY=                   # only for hosted services (OpenRouter, OpenAI, ...)
#
# Common:
#JUDGMENT_TIMEOUT=10                 # seconds per request (default 10 systemone / 120 openai)
#JUDGMENT_TIME_BUDGET=300            # seconds one tool call may spend on backend calls in total
